# Install all dependencies including optional
optional=true

# Don't skip lifecycle scripts (needed for sharp, bcrypt, etc.)
ignore-scripts=false

# Increase timeout for large installs
fetch-timeout=300000
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000

# Suppress audit output during install (vulnerabilities in sandbox deps
# are intentional — the sandbox itself provides the security boundary)
audit=false

# Suppress "looking for funding" message
fund=false
