{
  "functions": {
    "app/api/run/route.ts": {
      "maxDuration": 60
    },
    "app/api/snippets/[id]/files/route.ts": {
      "maxDuration": 30
    },
    "app/api/files/[id]/route.ts": {
      "maxDuration": 15
    }
  },
  "build": {
    "env": {
      "PUPPETEER_SKIP_DOWNLOAD": "true",
      "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1",
      "npm_config_audit": "false"
    }
  }
}