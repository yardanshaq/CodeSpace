# ============================================
# CODESPACE - Environment Variables
# ============================================

# PostgreSQL dari Neon (https://neon.tech)
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

# SuperAdmin (auto-dibuat di DB saat login pertama)
SUPERADMIN_USERNAME="superadmin"
SUPERADMIN_PASSWORD="superadmin123"

# ============================================
# UPSTASH REDIS (https://upstash.com)
# Buat database → copy URL dan TOKEN di bawah ini
# ============================================
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ============================================
# CHROMIUM (opsional, hanya untuk dev lokal)
# Kosongkan jika pakai default chrome path
# ============================================
# CHROMIUM_PATH="/usr/bin/google-chrome-stable"
# ============================================
PROXY_WORKER_URL="https://your-proxy-worker-url.workers.dev"
PROXY_WORKER_KEY="your-proxy-worker-key"
PROXY_DOMAINS="yourdomain.com"